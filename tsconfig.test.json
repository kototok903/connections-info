{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": [
      "vite/client",
      "node",
      "vitest/globals",
      "@testing-library/jest-dom"
    ],
    "paths": {
      "@/*": ["./src/*"],
      "#api/*": ["./api/*"],
      "#shared/*": ["./shared/*"]
    }
  },
  "include": ["api", "shared", "src", "test"],
  "exclude": []
}
